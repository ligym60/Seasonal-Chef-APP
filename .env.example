# Instacart Developer Platform API key (keep server-side only)
INSTACART_API_KEY=
# Dev/staging: https://connect.dev.instacart.tools  Production: https://connect.instacart.com
INSTACART_BASE_URL=https://connect.dev.instacart.tools
# Where Instacart's page links users back to
PARTNER_LINKBACK_URL=http://localhost:3000
PORT=3000
PANTRY_FILE=./data/pantry.json
# Shared secret callers must send as "Authorization: Bearer <token>" (generate e.g. with: openssl rand -hex 32)
APP_API_TOKEN=
# Number of reverse proxies in front of the app (1 for nginx) so rate limits use real client IPs
TRUST_PROXY=
